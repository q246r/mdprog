# MD simulation to compress SiC nanoparticle with virtual walls. 
# For ABCI

units		metal
boundary	f f f
atom_style	atomic

# Time steps
# Total time steps
variable        Ntot equal 500000
# Dump file interval
variable        N1 equal ${Ntot}/10
# Stress calc interval
variable        N2 equal ${Ntot}/500
# Thermo Info interval
variable        N3 equal ${Ntot}/500
# Prescribed temperature (K)
variable        Tset equal 300.0
# Prescribed pressure (bars)
#variable        Pset equal 1.0
# For example, 5 GPa
#variable       Pset equal 50000.0

#read_data	sic.lmp
#velocity        all create ${Tset} 376847 loop geom
read_restart	restart.data
reset_timestep	0

# Set up potential
# SiC
pair_style      vashishta
pair_coeff      * * ../../potentials/SiC.vashishta Si C

neighbor        1.0 bin
neigh_modify    every 1 delay 5 check yes one 4000   # A single atom can have 4,000 neighboring atoms.

# The unit of time is ps.
timestep        0.001

# Choose ensemble
# NEV ensemble
#fix		1 all nve
#    using velocity scaling method
#fix             2 all temp/rescale 1 ${Tset} ${Tset} 1.0 1.0
# NVT ensemble
fix            1 all nvt temp ${Tset} ${Tset} $(100.0*dt)
# NPT ensemble
#fix            1 all npt temp ${Tset} ${Tset} $(100.0*dt) iso ${Pset} ${Pset} $(1000.0*dt)
# Langevin thermostat
#fix		1 all langevin ${Tset} ${Tset} 100.0 48279

# Set wall
# velocity unit = Angstroms/picosecond = 100 m/s
variable        velz equal 0.301571
variable        ts equal step
variable        delta equal dt
variable        z1 equal zlo
variable        z2 equal zhi
variable        z1w equal "v_z1 + v_velz * v_ts * v_delta"
variable        z2w equal "v_z2 - v_velz * v_ts * v_delta"
variable        zlen equal "v_z2w - v_z1w"
#print "z2w = ${z2w}"
#print "z1w = ${z1w}"
fix             3 all wall/reflect zlo v_z1w zhi v_z2w units box

# Fix the center of gravity
fix		4 all momentum 100 linear 1 1 1
fix		5 all recenter 0.5 0.5 0.5 units fraction

# Output stress info to file
# for units metal, pressure is in [bars] = 100 [kPa] = 1/10000 [GPa]
# p2 to p7 are in GPa
# p1 is in ps.
variable	p1 equal "v_ts * v_delta"
variable	p2 equal "-pxx/10000"
variable	p3 equal "-pyy/10000"
variable	p4 equal "-pzz/10000"
variable	p5 equal "-pxy/10000"
variable	p6 equal "-pyz/10000"
variable	p7 equal "-pxz/10000"
variable	p8 equal "v_zlen"
fix		10 all print ${N2} "${p1} ${p2} ${p3} ${p4} ${p5} ${p6} ${p7} ${p8}" file stress.txt screen no

# Compute energy and stress per atom
compute		myEng all pe/atom
compute		myPress all stress/atom thermo_temp

# Output dump file
dump            1 all custom ${N1} dump.* id type xs ys zs c_myEng c_myPress[*]

# Display thermo
thermo		${N3}
thermo_style	custom step temp v_p2 v_p3 v_p4 press ke pe etotal
thermo_modify	lost ignore

run             ${Ntot}
write_restart	restart.data
#restart		${N1} restart.*
